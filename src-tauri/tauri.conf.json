{
    "version":  "0.1.0",
    "plugins": {
    "dialog": null,
    "fs": null
  },
    "productName":  "Nikon Photo Studio",
    "build":  {
                  "frontendDist":  "../dist",
                  "beforeBuildCommand":  "pnpm build",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "pnpm dev"
              },
    "app":  {
                "windows":  [
                                {
                                    "resizable":  true,
                                    "minWidth":  1024,
                                    "width":  1400,
                                    "minHeight":  700,
                                    "fullscreen":  false,
                                    "title":  "Nikon Photo Studio",
                                    "height":  900
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "$HOME/.nikon-photo-studio/**"
                                                                 ]
                                                   }
                             }
            },
    "$schema":  "https://raw.githubusercontent.com/nicedoc/tauri/main/crates/tauri-schema-generator/schemas/config.schema.json",
    "bundle":  {
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "both",
                                                "languages":  [
                                                                  "SimpChinese",
                                                                  "English"
                                                              ]
                                            }
                               },
                   "active":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "targets":  [
                                   "nsis"
                               ]
               },
    "identifier":  "com.nikon.photo-studio"
}